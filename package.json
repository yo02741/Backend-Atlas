{
  "name": "backend-atlas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "vite build",
    "prepreview": "node scripts/copy-pyodide.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "validate:quizzes": "node scripts/validate-quizzes.mjs",
    "e2e:runtime": "node e2e/runtime.mjs",
    "e2e:verify": "node e2e/verify-exercises.mjs",
    "e2e:sweep": "node e2e/sweep.mjs",
    "e2e:ui": "node e2e/ui-exercise.mjs && node e2e/ui-quiz.mjs && node e2e/ui-scenario.mjs",
    "e2e": "npm run e2e:runtime && npm run e2e:verify && npm run e2e:ui && npm run e2e:sweep",
    "validate:scenarios": "node scripts/validate-scenarios.mjs",
    "validate": "npm run validate:quizzes && npm run validate:scenarios"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@electric-sql/pglite": "^0.5.8",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "pyodide": "^314.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "playwright": "1.56.1"
  },
  "description": "看得見的後端基礎：給前端工程師的後端學習地圖（互動實驗室、瀏覽器內執行的練習題、Playground）"
}
